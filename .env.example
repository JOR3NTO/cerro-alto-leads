# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── API de Pacientes (Cerro Alto) ─────────────────────────────────────────────
# URL base de la API: aparece en la página de la prueba técnica
API_PACIENTES_URL=
# Token Bearer para autenticación
API_PACIENTES_TOKEN=

# ── LLM para clasificación de leads ──────────────────────────────────────────
# Proveedor elegido: gemini | groq | openrouter
LLM_PROVIDER=gemini
# API key del proveedor
LLM_API_KEY=
# Modelo específico (ej: gemini-1.5-flash, llama-3.1-8b-instant)
LLM_MODEL=gemini-1.5-flash

# ── Notificaciones (lead caliente → recepción en < 5 min) ────────────────────
# Canal: telegram | email
NOTIF_CANAL=telegram

# Si canal = telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Si canal = email (SMTP gratuito, ej: Gmail con App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_DESTINO=

# ── Configuración de la aplicación ───────────────────────────────────────────
# Puerto del servidor (por defecto 8000)
APP_PORT=8000
# Ruta del archivo SQLite (por defecto: parte-a/leads.db)
DATABASE_URL=sqlite:///parte-a/leads.db
